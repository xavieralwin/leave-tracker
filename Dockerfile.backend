# Use Node.js Debian slim
FROM node:20-slim

# Install build tools to compile native sqlite3 addon against container's GLIBC
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package manifests
COPY package*.json ./

# Compile sqlite3 native addon for container's exact glibc version
RUN npm ci --omit=dev --build-from-source=sqlite3

# Copy backend server code
COPY server/ ./server/

# Expose API port
EXPOSE 5000

# Start backend server
CMD ["node", "server/index.js"]
