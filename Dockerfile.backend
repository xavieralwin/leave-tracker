# Use Node.js for running the backend API (Debian slim for official prebuilt binary compatibility)
FROM node:20-slim

WORKDIR /app

# Copy package manifests
COPY package*.json ./

# Install production dependencies using pre-compiled binaries in seconds
RUN npm ci --omit=dev

# Copy the server directory
COPY server/ ./server/

# Expose the API port
EXPOSE 5000

# Run the Node Express server directly
CMD ["node", "server/index.js"]
